<mujoco model="tech_core_arm">
  <include file="robot_full.xml"/>
  <include file="terrain.xml"/>
  <!-- 科技核心六轴机械臂模型（按官方演示视频 + 网格 PCA 拟合的关节轴）：
       J1 底座回转(垂直) → J2 肩俯仰 → J3 肘俯仰 → J4 腕回转 → J5 腕俯仰 → J6 法兰回转 → 鼓
       鼓上带装配柱链：j_slide(滑槽100mm) → j_p(翻板 0..90°) → j_q(自旋 ±90°, 弹簧回正0.3N·m)
       q=0 时各臂节保持 CAD 原始位形（mesh 坐标 = world 坐标） -->
  <compiler angle="degree" meshdir="../assets"/>

  <option gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.5" armature="0.02"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <asset>
    <mesh name="arm_base" file="arm_base.stl"/>
    <mesh name="arm_l1" file="arm_l1.stl"/>
    <mesh name="arm_l2" file="arm_l2.stl"/>
    <mesh name="arm_l3" file="arm_l3.stl"/>
    <mesh name="arm_l4" file="arm_l4.stl"/>
    <mesh name="arm_l5" file="arm_l5.stl"/>
    <mesh name="arm_drum" file="arm_drum.stl"/>
    <mesh name="col_carriage" file="col_carriage.stl"/>
    <mesh name="col_pin" file="col_pin.stl"/>
    <mesh name="energy_unit" file="energy_unit_m.stl"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.75 0.75 0.75" rgb2="0.5 0.5 0.5"
             width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.1"/>
    <material name="base" rgba="0.55 0.30 0.12 1"/>
    <material name="l1" rgba="0.85 0.45 0.12 1"/>
    <material name="l2" rgba="0.9 0.5 0.15 1"/>
    <material name="l3" rgba="0.35 0.35 0.38 1"/>
    <material name="l4" rgba="0.85 0.45 0.12 1"/>
    <material name="l5" rgba="0.35 0.35 0.38 1"/>
    <material name="drum" rgba="0.72 0.74 0.78 1"/>
    <material name="carriage" rgba="0.42 0.44 0.48 1"/>
    <material name="pin" rgba="0.9 0.62 0.2 1"/>
    <material name="unit" rgba="0.2 0.5 0.9 1"/>
  </asset>

  <worldbody>
    <!-- 灯光 6 盏（老显卡逐像素光照是帧率瓶颈）；配平避免过曝削波：受光面≈0.85 保留立体感 -->
    <light name="key" pos="0 -3 4" dir="0 0 -1" diffuse="0.5 0.5 0.48" specular="0.15 0.15 0.15"/>
    <light name="amb" pos="0 0 6" diffuse="0.32 0.32 0.32" dir="0 0 -1"/>
    <light name="fill2" pos="-4 -4 5" diffuse="0.32 0.32 0.32" dir="0.5 0.5 -1"/>
    <light name="back" pos="-4 4 5" diffuse="0.28 0.28 0.28" dir="0.5 -0.5 -1"/>
    <light name="rig1" pos="0 -8 6" diffuse="0.42 0.42 0.4" dir="0 1 -1"/>
    <light name="rig3" pos="-8 0 6" diffuse="0.38 0.38 0.36" dir="1 0 -1"/>
    <camera name="cam" pos="0 -2.5 1.8" xyaxes="1 0 0 0 0.55 0.85"/>
    <!-- 地面/台阶碰撞由 terrain.xml 提供（图 4-27 A-A：G=-0.4，二级台阶 2×200mm） -->

    <!-- ===== 六轴机械臂 ===== -->
    <body name="arm_base" pos="0 0 0">
      <geom name="g_base" type="mesh" mesh="arm_base" material="base"/>
      <body name="arm_l1" pos="0 0 0">
        <joint name="j1" type="hinge" axis="0 0 1" pos="0.361 0.425 0.47" range="-170 170"/>
        <geom name="g_l1" type="mesh" mesh="arm_l1" material="l1"/>
        <body name="arm_l2" pos="0 0 0">
          <joint name="j2" type="hinge" axis="-0.343 0.939 0" pos="0.487 0.146 0.614" range="-120 120"/>
          <geom name="g_l2" type="mesh" mesh="arm_l2" material="l2"/>
          <body name="arm_l3" pos="0 0 0">
            <joint name="j3" type="hinge" axis="-0.343 0.939 0" pos="0.339 0.112 1.242" range="-150 150"/>
            <geom name="g_l3" type="mesh" mesh="arm_l3" material="l3"/>
            <body name="arm_l4" pos="0 0 0">
              <joint name="j4" type="hinge" axis="0.74 0.269 0.617" pos="0.04 0.224 1.053" range="-180 180"/>
              <geom name="g_l4" type="mesh" mesh="arm_l4" material="l4"/>
              <body name="arm_l5" pos="0 0 0">
                <joint name="j5" type="hinge" axis="-0.343 0.939 0" pos="-0.133 -0.094 0.974" range="-120 120"/>
                <geom name="g_l5" type="mesh" mesh="arm_l5" material="l5"/>
                <body name="arm_drum" pos="0 0 0">
                  <joint name="j6" type="hinge" axis="0 -1 0" pos="-0.133 -0.094 0.974" range="-180 180"/>
                  <geom name="g_drum" type="mesh" mesh="arm_drum" material="drum"/>

                  <!-- ===== 装配柱总成（滑槽 z 100mm → P 翻板 0..90° → Q 自旋 ±90°） ===== -->
                  <body name="col_carriage" pos="0 0 0">
                    <inertial pos="0 0 0" mass="0.05" diaginertia="0.002 0.002 0.002"/>
                    <joint name="j_slide" type="slide" axis="0 0 1" range="0 0.1"/>
                    <body name="col_pivot" pos="0 0 0">
                      <inertial pos="0 0 0" mass="0.05" diaginertia="0.002 0.002 0.002"/>
                      <joint name="j_p" type="hinge" axis="-1 0 0" pos="-0.1293 -0.22 0.876" range="0 90"/>
                      <body name="col_spin" pos="0 0 0">
                        <joint name="j_q" type="hinge" axis="0 -1 0" pos="-0.1293 -0.2265 0.7932"
                               range="-90 90" springref="0" stiffness="0.191" damping="0.05"/>
                        <geom name="carriage_vis" type="mesh" mesh="col_carriage" material="carriage"/>
                        <geom name="pin_vis" type="mesh" mesh="col_pin" material="pin"/>
                        <site name="pin_tip" pos="-0.1293 -0.333 0.7932" size="0.01" rgba="1 0 0 0.5"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ===== 能量单元（自由/吸附）：初始自然姿态=顶盖朝上、正面开口朝下（手册图4-39） ===== -->
    <body name="energy_unit" mocap="true" pos="-0.1293 -0.62 0.7932" quat="0.70710678 0.70710678 0 0">
      <geom name="energy_unit_vis" type="mesh" mesh="energy_unit" material="unit"/>
    </body>
  </worldbody>
</mujoco>
